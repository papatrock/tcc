@startuml
skinparam componentStyle rectangle
skinparam padding 4
skinparam nodesep 50
skinparam ranksep 50

title Arquitetura do Projeto (Layout em Colunas)

database "Datasets Brutos\n(WKT / GeoJSON)" as raw_data #LightGray

package "Bloco 1: Java" #E8F8F5 {
    component "Aplicação Java\n(Padrão Strategy)" as java_app #White
    component "JTS (Java Topology Suite)\n- Extração de MBRs\n- Cálculo de Partição" as jts #White
    file "Arquivo CSV gerado\n(Geometria + ID_Particao)" as csv_out #White
}

package "Bloco 2: PostgreSQL/PostGIS" #EBF5FB {
    database "PostgreSQL\n(Tabela Principal)" as pg_main #White
    collections "Fragmentação Física\n(Tabelas particionadas)" as particoes #White
    artifact "Índices Espaciais Locais\n(R-Tree / GiST)" as indices #White
}

package "Bloco 3: Benchmark e Métricas" #FDEDEC {
    component "Junção Espacial SQL\n(Workload Paralelo)" as workload #White
    component "Etapa 1: Filtro\n(ST_Intersects em MBRs)" as filtro #White
    component "Etapa 2: Refinamento\n(ST_Intersection exato)" as refino #White
    component "Monitoramento" as monitor #White
    card "Resultados" as resultados #White
}

' Entrada forçada para a direita
raw_data -right-> java_app : " Lê arquivos"

' Relacionamentos internos Bloco 1 (Para baixo)
java_app -down-> jts : " Processa matemáticas"
jts -down-> csv_out : " Gera rótulos"

' Transição Bloco 1 -> 2 (Forçada para a direita)
csv_out -right-> pg_main : " Importação de Dados"

' Relacionamentos internos Bloco 2 (Para baixo)
pg_main -down-> particoes : " Particionamento\nDeclarativo"
particoes -down-> indices : " Criação pelo PostGIS"

' Transição Bloco 2 -> 3 (Forçada para a direita)
indices -right-> workload : " Consulta utiliza\níndices locais"

' Relacionamentos internos Bloco 3 (Para baixo)
workload -down-> filtro : " Processa 1ª fase"
filtro -down-> refino : " Pares Candidatos"
refino -down-> monitor : " Execução"
monitor -down-> resultados : " Limpa cache\ne coleta dados"

@enduml